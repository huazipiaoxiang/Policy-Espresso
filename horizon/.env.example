# ===== 数据库 =====
# 本地默认 SQLite；云端/本地 postgres 示例：postgresql+psycopg://horizon:horizon@localhost:5432/horizon
DATABASE_URL=sqlite:////data/horizon.db
# 本地直跑（非 docker）时使用：
# DATABASE_URL=sqlite:///./horizon.db

# ===== LLM Provider（mock | ollama | dashscope）=====
LLM_PROVIDER=mock
# mock 样例应答对所有输入返回同一条政策；接入真实 LLM 前若要用离线规则从原文派生政策内容，设为 true（仅在 LLM_PROVIDER=mock 时生效）
LLM_OFFLINE_RULES=false
# 模型分层路由：分类打标 / 抽取 / 复杂推理 / 超长文档
LLM_MODEL_FLASH=qwen-flash
LLM_MODEL_PLUS=qwen-plus
LLM_MODEL_MAX=qwen-max
LLM_MODEL_LONG=qwen-long

# Ollama（本地，OpenAI 兼容端点）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b-instruct

# 阿里云百炼 DashScope（OpenAI 兼容端点，密钥绝不入库入仓）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 后端 =====
API_HOST=0.0.0.0
API_PORT=8000
# MVP 单用户 API Key；云端换 OIDC Bearer，接口不变
API_KEY=dev-local-key
# 前端跨域白名单，逗号分隔；本地 dev 端口不是 3000 时在此追加
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
TZ_DISPLAY=Asia/Hong_Kong
# APScheduler 时区；每日 09:00 抓取并分析，小时健康检查
SCHEDULER_TIMEZONE=Asia/Hong_Kong
# 周一心跳 cron（分 时 日 月 星期）
SCHEDULER_HEARTBEAT_CRON=0 8 * * mon
LOG_LEVEL=INFO
# 正文/快照存储目录（docker 内 /data）
STORAGE_DIR=/data/storage

# ===== 抓取合规 =====
CRAWL_USER_AGENT=HORIZON-PolicyMonitor/0.1 (+policy-research; contact@example.com)
CRAWL_MAX_RPS_PER_DOMAIN=1
CRAWL_RESPECT_ROBOTS=true

# ===== 前端 =====
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1

# ===== 分发（可选；未配置时降级为站内通知）=====
NOTIFY_EMAIL_WEBHOOK=
NOTIFY_WECOM_WEBHOOK=
NOTIFY_FEISHU_WEBHOOK=

# ===== Phase 5 云端 =====
# 存储后端：local（本地卷）| oss（阿里云对象存储）
STORAGE_BACKEND=local
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# FC 定时触发签名令牌（留空 = 禁用 /internal/jobs/*）
JOB_TRIGGER_TOKEN=

# 每文档最多解析的 PDF 附件数
CRAWL_MAX_ATTACHMENTS_PER_DOC=3
# 单源单轮最多抓取条数；0=不限制（测试/调试限量用）
CRAWL_MAX_ITEMS_PER_SOURCE=0
