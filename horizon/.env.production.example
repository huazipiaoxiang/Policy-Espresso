# 阿里云生产环境样例（10 §3 步骤 3）。密钥经 KMS/环境注入，禁止入库入仓。
DATABASE_URL=postgresql+psycopg://horizon:<密码>@rm-xxxx.mysql.rds.aliyuncs.com:5432/horizon

LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=sk-xxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_FLASH=qwen-flash
LLM_MODEL_PLUS=qwen-plus
LLM_MODEL_MAX=qwen-max
LLM_MODEL_LONG=qwen-long

API_KEY=<随机长密钥，与前端 HORIZON_API_KEY 一致>
JOB_TRIGGER_TOKEN=<FC 定时触发签名令牌>
TZ_DISPLAY=Asia/Hong_Kong
LOG_LEVEL=INFO

STORAGE_BACKEND=oss
OSS_BUCKET=horizon-policy-snapshots
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=<RAM 子账号 AK>
OSS_ACCESS_KEY_SECRET=<RAM 子账号 SK>

CRAWL_USER_AGENT=HORIZON-PolicyMonitor/0.1 (+policy-research; contact@example.com)

NEXT_PUBLIC_API_BASE=https://horizon.internal.example.com/api/v1
